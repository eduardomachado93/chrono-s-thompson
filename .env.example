# ==============================================================================
# CHRONO S. THOMPSON - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copie este arquivo para .env e preencha com suas respectivas credenciais:
# cp .env.example .env

# --- LLM Settings (OpenAI / Compatíveis) ---
# Obrigatório: Chave de API da OpenAI para orquestração e geração do artigo
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo principal para raciocínio e redação (ex: gpt-4o, gpt-4o-mini)
MODEL_NAME=gpt-4o

# Criatividade do redator Gonzo (Recomendado: 0.7 a 0.9 para estilo jornalístico autoral)
TEMPERATURE=0.8


# --- Search & News Correlation API ---
# Opcional/Recomendado: Tavily Search API para correlacionar fatos com o presente
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- MCP (Model Context Protocol) Server ---
# Caminho para o ponto de entrada do servidor FastMCP local
MCP_SERVER_SCRIPT=src/mcp_server/server.py

# Caminho do executável Python utilizado no transporte stdio do MCP
MCP_PYTHON_PATH=python


# --- Storage & Logging ---
# Diretório onde os artigos gerados (.md) serão persistidos
OUTPUT_DIR=storage/output

# Nível de detalhamento dos logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# --- Project Metadata & HTTP Headers ---
# Identidade do agente no cabeçalho e metadados
AGENT_NAME=Chrono S. Thompson

# User-Agent obrigatório conforme a política de uso da API da Wikimedia/Wikipedia
WIKIPEDIA_USER_AGENT=ChronoThompsonBot/1.0 (portfolio@dev.com)
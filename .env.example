# ==============================================================================
# CHRONO S. THOMPSON - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your credentials:
# cp .env.example .env

# --- LLM Settings (OpenAI / Compatible) ---
# Required: OpenAI API key for orchestration and article generation
OPENAI_API_KEY=your_key_here

# Primary LLM model for reasoning and article generation (e.g., gpt-4o, gpt-4o-mini)
MODEL_NAME=gpt-4o

# Model used for visual synthesis in the Photographer Node
IMAGE_MODEL_NAME='gpt-image-2-2026-04-21'

# Embedding model used for RAG indexing of Wikipedia historical content
EMBEDDING_MODEL_NAME='text-embedding-ada-002'

# Creativity / sampling temperature for Gonzo writer (Recommended: 0.7 to 0.9)
TEMPERATURE=0.8

# Sampling temperature for structured filtering in the Event Batcher Node
BATCHER_TEMPERATURE=0.8


# --- MCP (Model Context Protocol) Server ---
# Path to local FastMCP server entry point script
MCP_SERVER_SCRIPT=src/chrono_s_thompson/mcp_server/server.py

# Path to Python executable used for MCP stdio transport
MCP_PYTHON_PATH=.venv/Scripts/python.exe


# --- Storage & Logging ---
# Directory where generated articles (.md) will be persisted
OUTPUT_DIR=storage/output

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# --- Project Metadata & HTTP Headers ---
# Agent identity for headers and metadata
AGENT_NAME=Chrono S. Thompson

# Required User-Agent according to Wikimedia/Wikipedia API usage policy
WIKIPEDIA_USER_AGENT=ChronoThompsonBot/1.0 (portfolio@dev.com)